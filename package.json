{
  "name": "discord-bot-template-ts",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "ultracite check",
    "clean": "rimraf --glob node_modules .turbo \"{apps,packages}/*/{node_modules,.turbo}\"",
    "deps:update": "pnpm dlx taze -w -r -f",
    "dev": "turbo run dev",
    "fix": "ultracite fix",
    "format": "biome format --write .",
    "json:sort": "pnpm dlx sort-package-json package.json apps/*/package.json packages/*/package.json",
    "prepare": "husky",
    "release": "pnpm dlx bumpp -r",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "rimraf": "^6.1.4",
    "turbo": "^2.11.13",
    "ultracite": "8.3.1"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  }
}
